{
  "name": "linkedin-generator",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=./apps/web",
    "dev:api": "turbo run dev --filter=./apps/api",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@nestjs/swagger": "^11.1.4",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "turbo": "latest"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@8.14.0"
}
